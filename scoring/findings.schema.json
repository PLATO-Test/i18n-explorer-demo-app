{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://northstar-bank-poc.internal/schemas/findings.schema.json",
  "title": "i18n test findings",
  "description": "Shared output format for i18n test findings, produced by any of: deterministic Playwright checks, an AI judge, or an AI explorer agent.",
  "type": "object",
  "required": ["run", "findings"],
  "additionalProperties": false,
  "properties": {
    "run": {
      "type": "object",
      "description": "Metadata about the run that produced these findings.",
      "required": [
        "run_id",
        "source",
        "base_url",
        "started_at",
        "model",
        "input_tokens",
        "output_tokens",
        "cost_usd",
        "duration_s"
      ],
      "properties": {
        "run_id": { "type": "string", "minLength": 1 },
        "source": { "enum": ["deterministic", "ai_judge", "ai_explorer"] },
        "base_url": { "type": "string", "minLength": 1 },
        "started_at": { "type": "string", "format": "date-time" },
        "model": { "type": ["string", "null"] },
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "cost_usd": { "type": ["number", "null"], "minimum": 0 },
        "duration_s": { "type": "number", "minimum": 0 }
      }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_path",
        "data_testid",
        "category",
        "observed",
        "expected",
        "description",
        "severity",
        "evidence"
      ],
      "properties": {
        "page_path": {
          "type": "string",
          "description": "Path only, no host or query string, e.g. /fr/dashboard.",
          "pattern": "^/"
        },
        "data_testid": {
          "type": ["string", "null"],
          "description": "The element's data-testid, when the producer can determine one."
        },
        "category": {
          "enum": [
            "missing_translation",
            "placeholder",
            "hardcoded_text",
            "truncation",
            "number_currency_format",
            "date_format",
            "lang_attribute",
            "locale_navigation",
            "untranslated_validation",
            "plural",
            "terminology",
            "register",
            "mistranslation",
            "omission",
            "image_text",
            "other"
          ]
        },
        "observed": {
          "type": "string",
          "minLength": 1,
          "description": "The text, value, or image name actually seen."
        },
        "expected": { "type": ["string", "null"] },
        "description": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["high", "medium", "low"] },
        "evidence": {
          "type": ["string", "null"],
          "description": "Relative path to a screenshot or raw capture, when available."
        }
      }
    }
  }
}
